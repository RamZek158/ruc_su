# Copy this file to .env and fill real values. Never commit .env.

# Bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram numeric user id (you can get it from @userinfobot)
ADMIN_ID=123456789

# Optional: proxy for networks where Telegram is blocked
# On Windows, if empty, bot will try to use system proxy automatically.
# Examples:
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=http://127.0.0.1:8080
TELEGRAM_PROXY=
